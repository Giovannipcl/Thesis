if(skip_to_next) { next }
Beta = matrix(unlist(Beta),ncol = ncol(A),nrow = length(Beta[[1]]))
Gamma = apply(Beta[,1:10],1,gamma_f,index = index2)
Gamma_est = Sigma%*%Gamma
library(coda)
hpd_intervals = HPDinterval(as.mcmc(t(Gamma_est)))
hpd_intervals2 = HPDinterval(as.mcmc((Beta)))
gamma = apply(Gamma_est,1,mean)
dentro_intervalo <- gamma_true >= hpd_intervals[, "lower"] & gamma_true <= hpd_intervals[, "upper"]
dentro_intervalo = as.numeric(dentro_intervalo)
dentro_intervalo2 <- t(t(beta_true)) >= hpd_intervals2[, "lower"] & t(t(beta_true)) <= hpd_intervals2[, "upper"]
dentro_intervalo2 = as.numeric(dentro_intervalo2)
for(i in 1:ncol(A)){
medias[k,i] = (sum(diff(marginal(i,post_multi)$xis)[1]*(marginal(i,post_multi)$xis)*marginal(i,post_multi)$pila_marginal))
}
medias_gamma[k,] = gamma
medias2[k,] = apply(Beta,2,mean)
print(dentro_intervalo)
print(dentro_intervalo2)
cover[k,] = dentro_intervalo
cover2[k,] = dentro_intervalo2
}
