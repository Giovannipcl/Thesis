amostra_simu = function(len_beta, beta, betas, X, range_y){
yo = seq(range_y[1],range_y[2],0.1)    #Isso pode ser alterado
data = as.data.frame(cbind(yo))
sspec <- s(yo, k = len_beta , bs = "ps")    #Spline tamanho 10
sspec$mono <- 1
sm2 <- smoothCon(sspec, data = data, scale.penalty=FALSE, absorb.cons = F)[[1]]
sm2$knots
A = sm2$X
index2 = c(sm2$g.index)
K1 = sm2$S[[1]] + diag(10^-6,dim(A)[2])
beta = mvrnorm(1,rep(0,dim(A)[2]),solve(exp(5)*(K1)));beta
beta[1] = -3
gamma = beta
gamma[index2] = exp(beta[index2])
yo = seq(range_y[1]-8,range_y[2]+8,0.1)
data = as.data.frame(cbind(yo))
amostra = 0
cont_aux = 1
yo = seq(-30,30,0.1)
data = as.data.frame(cbind(yo))
#dfyx(r,sm2,gamma,X[cont_aux,],betas)
#plot(yo,dfyx(yo,sm2,gamma,X[cont_aux,],betas))
#abline(v = r)
while(cont_aux<dim(X)[1] + 1){
mean_prop = (data$yo - c(X[cont_aux,]%*%betas))[which((dfyx(data$yo -  c(X[cont_aux,]%*%betas),sm2,gamma,X[cont_aux,],betas)) == max(dfyx(data$yo -  c(X[cont_aux,]%*%betas),sm2,gamma,X[cont_aux,],betas)))]
cont = 0
while(cont < 500){
r = rnorm(1,mean_prop,4) # tirar o efeito de x para aplicar no spline
u = runif(1)
if(u < dfyx(r,sm2,gamma,X[cont_aux,],betas)/(4*dnorm(r,mean_prop,4))){
amostra = c(amostra,r)
cont = cont + 1
break;
}
}
cont_aux = cont_aux + 1
}
return(list(amostra = amostra[-1],data = yo,model = sm2,gamma = gamma))
}
