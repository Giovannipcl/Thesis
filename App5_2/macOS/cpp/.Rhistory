yo = seq(range_y[1],range_y[2],0.1)    #Isso pode ser alterado
data = as.data.frame(cbind(yo))
sspec <- s(yo, k = npar , bs = "ps")    #Spline tamanho 10
sspec$mono <- 1
sm2 <- smoothCon(sspec, data = data, scale.penalty=FALSE, absorb.cons = F)[[1]]
A = sm2$X
index2 = c(sm2$g.index)
K1 = sm2$S[[1]] + diag(10^-6,dim(A)[2])
###### Efeito aleat ##########
Nind = 75
n_rep = 20
ind = rep(seq(1:Nind), each = n_rep)
ind = as.factor(ind)
P = diag(Nind) - c(1/((rep(1,Nind))%*%((rep(1,Nind)))))*((rep(1,Nind))%*%t(rep(1,Nind)))
rep(1,Nind)%*%rep(1,Nind)
X = model.matrix(~-1 + ind)
#X = model.matrix(~ ind, contrasts = list(ind = "contr.sum"))
b = rnorm(Nind,0,1)
b = (P%*%b)
sum(b)
nsample = dim(X)[1]
Xm = matrix(0, nrow = nsample, ncol = 2)
Xm[,1] = rbinom(nsample,1,0.5)
Xm[,2] = rnorm(nsample,0,1)
#log(teste$gamma)
betas = c(b, 1,-0.8)
X = cbind(X,Xm)
###########################
beta = c(-3,-0.2977453 ,-0.2970083 ,-0.3014625, -0.2986763 ,-0.2948151, -0.2964417 ,-0.2980049 ,-0.2960857, -0.2954280)
beta = mvrnorm(1,rep(0,dim(A)[2] ),solve((1/exp(-7))*(K1)));beta
beta[1] = -3
medias = matrix(0,500,ncol(A))
medias2 = matrix(0,500,ncol(A))
ncol(A)
medias = matrix(0,500,ncol(A) + ncol(X))
medias2 = matrix(0,500,ncol(A) + ncol(X))
medias_gamma = matrix(0,500,ncol(A))
cover = matrix(0,500,ncol(A))
cover2 = matrix(0,500,ncol(A)+ncol(X))
Sigma <- matrix(0, nrow = ncol(A), ncol = ncol(A))
Sigma[lower.tri(Sigma, diag = TRUE)] <- 1
gamma = gamma_f(beta,index2)
gamma_true = Sigma%*%gamma;gamma_true
beta_true = c(beta,betas)
