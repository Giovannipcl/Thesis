# Função para calcular polinômios de Bernstein
bernstein_poly <- function(x, n, v) {
choose(n, v) * (x^v) * ((1 - x)^(n - v))
}
# Parâmetros
grau <- 1  # Grau do Bernstein
x <- seq(0, 1, 0.01)
# Construindo a matriz de Bernstein
Rf <- do.call(rbind, lapply(x, function(xi) {
data.frame(
B = sapply(0:grau, function(v) bernstein_poly(xi, grau, v)),
V2 = 0:grau,
y = rep(xi, grau + 1)
)
}))
