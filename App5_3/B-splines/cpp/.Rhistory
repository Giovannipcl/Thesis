library(shiny)
library(ggplot2)
# Função para calcular polinômios de Bernstein
bernstein_poly <- function(x, n, v) {
choose(n, v) * (x^v) * ((1 - x)^(n - v))
}
# Parâmetros
x <- seq(0, 1, 0.01)
# Construindo a matriz de Bernstein para graus 1 a 4
Rf <- do.call(rbind, lapply(1:4, function(grau) {
do.call(rbind, lapply(x, function(xi) {
data.frame(
B = sapply(0:grau, function(v) bernstein_poly(xi, grau, v)),
V2 = paste0("Grau ", grau, " - V", 0:grau),
y = rep(xi, grau + 1),
Grau = grau
)
}))
}))
# Interface do Shiny
ui <- fluidPage(
titlePanel("Polinômios de Bernstein"),
sidebarLayout(
sidebarPanel(
selectInput("grau", "Escolha o Grau:", choices = 1:4, selected = NULL)
),
mainPanel(
plotOutput("grafico")
)
)
)
# Servidor do Shiny
server <- function(input, output) {
output$grafico <- renderPlot({
req(input$grau)  # Só exibe se um grau for selecionado
ggplot(Rf[Rf$Grau == input$grau, ], aes(x = y, y = B, color = factor(V2))) +
geom_line() +
labs(title = paste("Bernstein Polynomials of Degree", input$grau),
x = "y", y = "B") +
theme_minimal()
})
}
# Executar app
shinyApp(ui = ui, server = server)
library(plotly)
# Função para calcular polinômios de Bernstein
bernstein_poly <- function(x, n, v) {
choose(n, v) * (x^v) * ((1 - x)^(n - v))
}
# Parâmetros
x <- seq(0, 1, 0.01)
# Construindo a matriz de Bernstein para graus 1 a 4
Rf <- do.call(rbind, lapply(1:4, function(grau) {
do.call(rbind, lapply(x, function(xi) {
data.frame(
B = sapply(0:grau, function(v) bernstein_poly(xi, grau, v)),
V2 = paste0("Grau ", grau, " - V", 0:grau),
y = rep(xi, grau + 1),
Grau = grau
)
}))
}))
# Função para gerar o gráfico com Plotly
plot_bernstein <- function(grau) {
df <- Rf[Rf$Grau == grau, ]
plot_ly(data = df, x = ~y, y = ~B, color = ~V2, type = 'scatter', mode = 'lines') %>%
layout(title = paste("Bernstein Polynomials of Degree", grau),
xaxis = list(title = "y"),
yaxis = list(title = "B"))
}
# Exemplo de gráfico interativo com um grau selecionado
plot_bernstein(2)  # Aqui você pode testar com diferentes graus
