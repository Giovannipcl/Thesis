# Função para calcular polinômios de Bernstein
bernstein_poly <- function(x, n, v) {
choose(n, v) * (x^v) * ((1 - x)^(n - v))
}
# Parâmetros
x <- seq(0, 1, 0.01)
# Construindo a matriz de Bernstein para graus 1 a 4
Rf <- do.call(rbind, lapply(1:4, function(grau) {
do.call(rbind, lapply(x, function(xi) {
data.frame(
B = sapply(0:grau, function(v) bernstein_poly(xi, grau, v)),
V2 = paste0("Grau ", grau, " - V", 0:grau),
y = rep(xi, grau + 1),
Grau = grau
)
}))
}))
# Cria data frame
Rf <- as.data.frame(Rf)
# Gráfico
tx <- highlight_key(Rf, ~Grau)
widgets <- bscols(filter_checkbox("Grau", "Escolha o Grau", tx, ~Grau))
bscols(
widths = c(2, 10),
widgets,
plot_ly(tx,
x = ~y,
y = ~B,
color = ~factor(V2),
type = 'scatter',
mode = 'lines',
line = list(simplify = F)
) %>%
layout(title = list(text = "Bernstein Polynomials"),
xaxis = list(title = 'y'), autosize = F, width = 700, height = 350)
)
