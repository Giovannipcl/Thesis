marginal_year = function(i,Xma, h1C,Xyear2,dXyear2,yseq){
print(i)
for(j in 1:50){
h2C = ((Xma[j,]%*%gamma2[(ncol(Ay)+1 +5+ dim(Xmes)[2]):(ncol(A)),]) + (Xyear2%*%gamma2[(ncol(Ay)+1):(ncol(Ay) + 5),])[i,])
dY = apply(sweep(h1C,2,h2C,"+"),1,dnorm)*t(Ayd%*%gamma2[1:ncol(Ay),])
eyC = apply(sweep(dY,2,yseq,"*"),1,sum)#1
eymarC = (apply(sweep(dY,2,yseq*diff(yseq)[1],"*")*t(sweep(h1C,2,h2C,"+")),1,sum)) #3
EYmarC[j,] = eymarC
}
return(apply(EYmarC,2,mean)*c(-dXyear2[i,]%*%gamma2[(ncol(Ay)+1):(ncol(Ay) + 5),]))
}
yeareffect = marginal_year(1,Xma,h1C,Xyear2,dXyear2, yseq)
dim(Xmes)[2]
(ncol(Ay)+1 + dim(Xmes)[2])
